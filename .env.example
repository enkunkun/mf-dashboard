# mf-dashboard environment variables
#
# 1. Copy this file to `.env`.
# 2. Fill in the required values below.
# 3. Copy `terraform/terraform.tfvars.example` to `terraform/terraform.tfvars`
#    and fill in all infrastructure settings.

# -----------------------------------------------------------------------------
# Required: MoneyForward credentials in 1Password
# -----------------------------------------------------------------------------

OP_SERVICE_ACCOUNT_TOKEN=
OP_VAULT=
OP_ITEM=
OP_TOTP_FIELD=

# -----------------------------------------------------------------------------
# Required: Application authentication
# -----------------------------------------------------------------------------

# Generate with `openssl rand -hex 32`.
REFRESH_TOKEN=

# Cloudflare Access origin authentication. Copy the AUD from
# `terraform output -raw access_application_aud`.
CLOUDFLARE_ACCESS_TEAM_DOMAIN=
CLOUDFLARE_ACCESS_AUD=

# Public URL used for Open Graph/Twitter metadata and crawler notifications.
DASHBOARD_URL=

# URL prefix used when the dashboard is served below the domain root.
# NEXT_PUBLIC_BASE_PATH=/dashboard

# -----------------------------------------------------------------------------
# Optional: Notifications
# -----------------------------------------------------------------------------

# Slack Bot (requires chat:write scope)
# SLACK_BOT_TOKEN=xoxb-xxx
# SLACK_CHANNEL_ID=C0XXXXXXXXX

# Discord Incoming Webhook
# DISCORD_WEBHOOK_URL=
# DISCORD_AVATAR_URL=

# -----------------------------------------------------------------------------
# Optional: Crawler
# -----------------------------------------------------------------------------

# Account update timeout in minutes (default: 20).
# MAX_WAIT_MINUTES=20

# Linux bind mounts may need the host user IDs so crawler can write ./data.
# HOST_UID=1000
# HOST_GID=1000

# Browser storage state path. Docker Compose sets this to a crawler-only volume.
# AUTH_STATE_PATH=

# -----------------------------------------------------------------------------
# Optional: PayPay 取引履歴の自動取込
# -----------------------------------------------------------------------------

# PayPay のトークンを 1Password の項目へ保管する場合に設定する。
# 未設定ならローカルの `~/.local/share/paypay-hook/tokens.json` を使う（開発用）。
# OP_PAYPAY_ITEM=PayPay
# OP_PAYPAY_FIELD=tokens
# 取得した CSV の作業ディレクトリ（コンテナ内）。Docker Compose の既定は /tmp/paypay。
# PAYPAY_DIR=/tmp/paypay

# -----------------------------------------------------------------------------
# Optional: モバイルSuica 利用履歴の自動取込
# -----------------------------------------------------------------------------

# JRE ID のパスキーを 1Password の項目から読む。既定は下記。
# OP_SERVICE_ACCOUNT_TOKEN / OP_VAULT は crawler が既に使っているものを流用する。
# SUICA_OP_ITEM=JRE ID passkey (Suica)
# SUICA_OP_VAULT=apps

# -----------------------------------------------------------------------------
# Optional: ファミペイ (FamiPay) の残高・利用履歴の取込
# -----------------------------------------------------------------------------
#
# ファミペイの ID / パスワードを 1Password の項目から読む。既定は下記。
# OP_SERVICE_ACCOUNT_TOKEN / OP_VAULT は crawler が既に使っているものを流用する。
# 毎回のログインで SMS のワンタイムコード入力が必要（実 Chrome で人が操作する）。
# OP_FAMIPAY_ITEM=FamiPay
# OP_FAMIPAY_VAULT=apps
# ログイン完了を待つ秒数（既定 600）。
# FAMIPAY_LOGIN_TIMEOUT_SEC=600

# -----------------------------------------------------------------------------
# Optional: enひかり（光コラボ回収代行分）の按分
# -----------------------------------------------------------------------------

# enひかり電気の会員ページ（ご利用明細）の認証情報を 1Password の項目から読む。既定は下記。
# username に お客様ID、password にパスワードを入れる。
# OP_ENHIKARI_ITEM=enhikari.jp
# OP_ENHIKARI_VAULT=apps

# -----------------------------------------------------------------------------
# Optional: AI features (finance chat and transaction categorization)
# -----------------------------------------------------------------------------

# Supported providers: openai, anthropic, google.
# All three values are required when using an AI feature.
# AI_PROVIDER=
# AI_API_KEY=
# Agent Observability: agent generations + OTLP traces/metrics to Grafana Cloud.
# Keep tokens only in the untracked .env file on the deployment host.
# AGENTO11Y_ENDPOINT=
# AGENTO11Y_PROTOCOL=http
# AGENTO11Y_AUTH_MODE=basic
# AGENTO11Y_AUTH_TENANT_ID=
# AGENTO11Y_AUTH_TOKEN=
# OTEL_EXPORTER_OTLP_ENDPOINT=
# OTEL_EXPORTER_OTLP_HEADERS=
# AI_MODEL=
# AI_CHAT_PRESETS=今月の収支は？,先月と比べてどう？,削れそうな支出はある？,総資産を教えて
# -----------------------------------------------------------------------------
# [optional] 複利シミュレーターの初期値
# -----------------------------------------------------------------------------

# 据え置き期間（積立も取崩しもしない運用のみの区間）は、CONTRIBUTION_YEARS < WITHDRAWAL_START_YEAR のときに暗黙的に発生します。
# NEXT_PUBLIC_SIMULATOR_CURRENT_AGE=30                # 現在の年齢
# NEXT_PUBLIC_SIMULATOR_INITIAL_AMOUNT=1000000        # 初期投資額(円)
# NEXT_PUBLIC_SIMULATOR_MONTHLY_CONTRIBUTION=50000    # 毎月の積立額(円)
# NEXT_PUBLIC_SIMULATOR_ANNUAL_RETURN_RATE=7.5        # 想定利回り(%)
# NEXT_PUBLIC_SIMULATOR_INFLATION_RATE=2              # インフレ率(%)
# NEXT_PUBLIC_SIMULATOR_CONTRIBUTION_YEARS=30         # 積立年数
# NEXT_PUBLIC_SIMULATOR_WITHDRAWAL_START_YEAR=30      # 取崩し開始年(積立開始からの年数)
# NEXT_PUBLIC_SIMULATOR_WITHDRAWAL_YEARS=30           # 取崩し年数
# NEXT_PUBLIC_SIMULATOR_WITHDRAWAL_MODE=amount        # 取崩しモード(amount: 金額指定 / rate: %指定)
# NEXT_PUBLIC_SIMULATOR_WITHDRAWAL_RATE=4             # 年間引出率(%) ※%指定モード時
# NEXT_PUBLIC_SIMULATOR_MONTHLY_WITHDRAWAL=250000     # 月額生活費総額(円) ※金額指定モード時
# NEXT_PUBLIC_SIMULATOR_EXPENSE_RATIO=0.1             # 信託報酬(%)
# NEXT_PUBLIC_SIMULATOR_VOLATILITY=15                 # ボラティリティ(%)
# NEXT_PUBLIC_SIMULATOR_BASE_PENSION=0                # 年金月額 65歳基準・税引前(円)
# NEXT_PUBLIC_SIMULATOR_PENSION_START_AGE=65           # 年金受給開始年齢
# NEXT_PUBLIC_SIMULATOR_MONTHLY_OTHER_INCOME=0         # その他の月収・手取り(円)
